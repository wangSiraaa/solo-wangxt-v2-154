# 默认使用 PostgreSQL。开发/离线环境可改用 SQLite：
# DATABASE_URL=sqlite:///./jiaokan.db
DATABASE_URL=postgresql+psycopg://jiaokan:jiaokan@localhost:5432/jiaokan

# CollateX 调用方式：
#   http  —— POST JSON 到 CollateX REST 端点
#   cli   —— 以管道方式调用 collate-tools 命令行
#   auto  —— 先探测本地 7369 端口的 CollateX，失败则退回内置序列比对
COLLATEX_MODE=auto
COLLATEX_URL=http://localhost:7369/collate
COLLATEX_CLI=collatex

# 是否允许把内置退回实现写入 alignment_run.engine
SEED_ON_STARTUP=true
